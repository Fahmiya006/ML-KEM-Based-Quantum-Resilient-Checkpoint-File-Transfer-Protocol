        </mxCell>
        <mxCell id="f15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="d2" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note2" value="Baseline (no checkpoint): T = detect + reconnect + FULL ML-KEM handshake + retransmit all verified chunks&#10;Proposed: T = detect + reconnect + 1 RTT resume + remaining chunks only" style="text;html=1;align=left;fontSize=11;fontColor=#555555;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="130" y="1080" width="620" height="40" as="geometry" />
